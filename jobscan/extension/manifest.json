{
  "manifest_version": 3,
  "name": "jobscan capture",
  "version": "1.1",
  "description": "Paced, button-triggered capture of your own LinkedIn post search results to the jobscan pipeline, in the background.",
  "permissions": ["downloads", "storage"],
  "host_permissions": ["https://www.linkedin.com/*", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/search/results/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
